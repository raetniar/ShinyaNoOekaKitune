{
  "manifest_version": 3,
  "name": "TW-Alert - 配信開始通知＆リスト",
  "short_name": "TW-Alert",
  "version": "1.0.1",
  "description": "お気に入りの配信者のLIVE開始をデスクトップ通知し、配信中リストをひと目で確認できる軽量ツール（Twitch対応）。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "TWlist - 配信通知"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://gql.twitch.tv/*"
  ]
}